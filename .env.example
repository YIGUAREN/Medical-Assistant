# ==================== LLM 大模型配置 ====================
DASHSCOPE_API_KEY=your_dashscope_api_key

# ==================== 嵌入模型配置 ====================
# 可选: DASHSCOPE | SENTENCE_TRANSFORMER
EMBED_MODEL_TYPE=DASHSCOPE

# 当 EMBED_MODEL_TYPE=SENTENCE_TRANSFORMER 时生效
# 模型会自动下载到本地缓存
SENTENCE_TRANSFORMER_MODEL_NAME=BAAI/bge-large-zh-v1.5
